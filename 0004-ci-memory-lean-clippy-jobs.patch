From 94dc66321ae277cbf23cd619f9885fbb359750f8 Mon Sep 17 00:00:00 2001
From: openhands <openhands@all-hands.dev>
Date: Fri, 9 Oct 2026 10:30:41 +0000
Subject: [PATCH] ci: make the clippy jobs memory-lean so they can't OOM the
 runner

The five clippy/check jobs run `CARGO_BUILD_JOBS: 3` against the default
debug profile, whose debuginfo makes the `diesel` `128-column-tables`
frontend spike ~13 GiB per rustc invocation. Three of those at once on a
16 GiB `ubuntu-latest` runner is what made `just clippy` the gating failure.

Apply the same workaround proven in the sandbox, as workflow-level env:

- `CARGO_PROFILE_DEV_DEBUG=false` (plus debug-assertions/overflow-checks
  off) keeps the peak under ~10 GiB. Inert for CI correctness: no job here
  runs `cargo test`, only clippy/check.
- `CARGO_BUILD_JOBS=1` serialises rustc so two ~10 GiB spikes never
  overlap, and replaces the per-step `3` overrides on the clippy steps.

Caching was already thorough (Swatinem/rust-cache keyed on the lockfile +
sccache for individual compilation units), so serialising rustc is a
one-time cost per lockfile change, not a per-run one -- the sustainable
form of "it needs a lot of memory for one step", rather than sizing the
build to all of the runner's RAM.

This file was changed by an AI agent (OpenHands) on behalf of the user.

Co-authored-by: openhands <openhands@all-hands.dev>
---
 .github/workflows/ci.yml | 25 +++++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 62eac6ac4..c8d80596a 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -78,6 +78,23 @@ env:
   CARGO_TERM_COLOR: always
   RUSTC_WRAPPER: sccache
   SCCACHE_GHA_ENABLED: "true"
+  # Memory-lean build profile, mirroring the sandbox workaround for the
+  # diesel `128-column-tables` frontend spike: a single rustc invocation on
+  # `diesel` peaks near ~10 GiB in the default debug profile (debuginfo is
+  # the bulk of it). Dropping debuginfo and the debug-only runtime checks
+  # keeps the peak comfortably under a 16 GiB GitHub runner. This does not
+  # change what clippy/check verify -- CI runs no `cargo test`, so turning
+  # debug-assertions/overflow-checks off is inert here.
+  CARGO_PROFILE_DEV_DEBUG: "false"
+  CARGO_PROFILE_DEV_DEBUG_ASSERTIONS: "false"
+  CARGO_PROFILE_DEV_OVERFLOW_CHECKS: "false"
+  # Serialise rustc. The heavy crates (diesel, diesel_models,
+  # migrations_internals, num_cpus) each spike ~10 GiB; letting several run
+  # concurrently is what tips a 16 GiB runner into the OOM killer. The
+  # rust-cache + sccache layers above make this a one-time cost per
+  # lockfile, not a per-run one. (This used to be `3` on the clippy steps --
+  # exactly the "give it all our RAM" setting this replaces.)
+  CARGO_BUILD_JOBS: 1
   # Whether this run is the one allowed to persist caches for everything
   # below -- only a push to `main` is the canonical build; PRs and
   # merge-queue runs restore from it but never overwrite it.
@@ -347,14 +364,10 @@ jobs:
 
       - name: Run clippy (redis-rs backend)
         shell: bash
-        env:
-          CARGO_BUILD_JOBS: 3
         run: just clippy
 
       - name: Run clippy (fred backend)
         shell: bash
-        env:
-          CARGO_BUILD_JOBS: 3
         run: just clippy fred
 
       - name: Check Cargo.lock changed
@@ -466,15 +479,11 @@ jobs:
       - name: Run cargo clippy with v2 features enabled (redis-rs backend)
         if: github.event_name == 'pull_request'
         shell: bash
-        env:
-          CARGO_BUILD_JOBS: 3
         run: just clippy_v2
 
       - name: Run cargo clippy with v2 features enabled (fred backend)
         if: github.event_name == 'pull_request'
         shell: bash
-        env:
-          CARGO_BUILD_JOBS: 3
         run: just clippy_v2 fred
 
       - name: Run cargo check enabling only the release and v2 features (redis-rs backend)
-- 
